{
  "name": "beam",
  "version": "2.0.3",
  "description": "Beam: play Android games on your computer (mouse + keyboard) over Wi-Fi. Pixel/Android phone -> browser, Windows app or Mac app.",
  "main": "app/main.js",
  "scripts": {
    "start": "node server.js --open",
    "server": "node server.js",
    "preview-design": "node scripts/preview-design.js",
    "test": "node --experimental-vm-modules --test tests/*.test.cjs",
    "app": "electron .",
    "build-server": "node ../android-server/build.js",
    "package-win": "node scripts/package-win.js",
    "installer": "node scripts/build-installer.js"
  },
  "keywords": [
    "android",
    "adb",
    "screen-mirroring",
    "game-streaming",
    "keymapping",
    "webcodecs"
  ],
  "author": "Darko",
  "license": "MIT",
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^44.5.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.beam.desktop",
    "productName": "Beam",
    "copyright": "Darko",
    "directories": {
      "output": "dist/installer"
    },
    "asar": false,
    "files": [
      "**/*",
      "!dist/**",
      "!scripts/**",
      "!tests/**",
      "!platform-tools/**",
      "!.claude/**",
      "!**/*.log",
      "!data/**"
    ],
    "extraResources": [
      {
        "from": "platform-tools",
        "to": "platform-tools"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "app/icon.ico",
      "executableName": "Beam"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Beam",
      "artifactName": "Beam-${version}-Windows-Setup.${ext}",
      "installerIcon": "app/icon.ico",
      "uninstallerIcon": "app/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "app/icon-mac.png",
      "category": "public.app-category.games",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "Beam-${version}-macOS-${arch}.${ext}"
    },
    "dmg": {
      "title": "Beam ${version}",
      "writeUpdateInfo": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Limboo369",
        "repo": "widex"
      }
    ]
  }
}
