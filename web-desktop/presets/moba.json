{
  "name": "MOBA (Wild Rift, Mobile Legends...)",
  "description": "WASD kretanje, Q/W/E/R sposobnosti su na tasterima 1-4 (pošto je W kretanje), Space napad. Kamera mišem je isključena.",
  "order": 3,
  "mouse": { "sensitivity": 1.0, "invertY": false },
  "cursorKey": "Backquote",
  "startInCursorMode": true,
  "controls": [
    { "type": "joystick", "x": 0.14, "y": 0.72, "radius": 0.12, "up": "KeyW", "down": "KeyS", "left": "KeyA", "right": "KeyD", "sprint": "", "sprintScale": 1.0 },
    { "type": "button", "key": "Space", "x": 0.88, "y": 0.78, "mode": "hold", "label": "Napad" },
    { "type": "button", "key": "Digit1", "x": 0.73, "y": 0.86, "mode": "tap", "label": "Q" },
    { "type": "button", "key": "Digit2", "x": 0.75, "y": 0.66, "mode": "tap", "label": "W" },
    { "type": "button", "key": "Digit3", "x": 0.82, "y": 0.55, "mode": "tap", "label": "E" },
    { "type": "button", "key": "Digit4", "x": 0.93, "y": 0.5, "mode": "tap", "label": "R" },
    { "type": "button", "key": "KeyB", "x": 0.55, "y": 0.9, "mode": "tap", "label": "Nazad" },
    { "type": "button", "key": "KeyF", "x": 0.63, "y": 0.9, "mode": "tap", "label": "Spell 1" },
    { "type": "button", "key": "KeyV", "x": 0.68, "y": 0.9, "mode": "tap", "label": "Spell 2" }
  ]
}
